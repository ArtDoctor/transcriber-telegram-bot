# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# ElevenLabs API key
ELEVENLABS_API_KEY=

# Required only when running the self-hosted Telegram Bot API server
# https://my.telegram.org/apps
API_ID=
API_HASH=

# Local Telegram Bot API server endpoints. docker-compose sets these for the bot
# container automatically; set them manually only for non-compose deployments.
# TELEGRAM_BOT_API_BASE_URL=http://127.0.0.1:8081/bot
# TELEGRAM_BOT_API_BASE_FILE_URL=http://127.0.0.1:8081/file/bot
# TELEGRAM_LOCAL_MODE=true
# MAX_TELEGRAM_DOWNLOAD_BYTES=2147483648
# MAX_TELEGRAM_UPLOAD_BYTES=2147483648
# TELEGRAM_READ_TIMEOUT=900
# TELEGRAM_WRITE_TIMEOUT=900

# Optional ElevenLabs settings
# ELEVENLABS_MODEL=scribe_v2
# ELEVENLABS_LANGUAGE_CODE=en
# ELEVENLABS_NUM_SPEAKERS=
# ELEVENLABS_TAG_AUDIO_EVENTS=false
# ELEVENLABS_NO_VERBATIM=false
# ELEVENLABS_USE_MULTI_CHANNEL=false
# MAX_CONCURRENT_TRANSCRIPTIONS=2
# LOG_LEVEL=INFO
